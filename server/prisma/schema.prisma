// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../libs/shared/src/generated/prisma"
  moduleFormat = "cjs" // 模块格式
}

datasource db {
  provider = "postgresql"
}

enum TradeStatus {
  NOT_PAY // 未支付 默认值非支付宝枚举 自定义
  WAIT_BUYER_PAY // 等待买家付款
  TRADE_CLOSED // 交易关闭
  TRADE_SUCCESS // 交易成功 可退款
  TRADE_FINISHED // 交易结束 不可退款
}

//用户表
model User {
  id              String           @id @default(cuid()) // 用户ID
  name            String // 用户名
  email           String?          @unique // 邮箱
  phone           String           @unique // 手机号
  address         String? // 地址
  password        String // 密码
  avatar          String? // 头像
  wordNumber      Int              @default(0) // 单词数量
  dayNumber       Int              @default(0) // 打卡天数
  createdAt       DateTime         @default(now()) // 创建时间
  updatedAt       DateTime         @updatedAt // 更新时间
  lastLoginAt     DateTime? // 最后登录时间
  wordBookRecords WordBookRecord[]
  paymentRecords  PaymentRecord[]
  courseRecords   CourseRecord[]
  studyGoal       StudyGoal?
  checkIns        CheckIn[]
  chatSessions    ChatSession[]
  words           WordBook[]       @relation("UserWords")
  wordBooks       UserWordBook[]
  courses         Course[]         @relation("UserCourses")
  importJobs      ImportJob[]
  bio             String? // 签名  
  isTimingTask    Boolean          @default(false) // 是否开启定时任务 
  timingTaskTime  String           @default("00:00:00") //定时任务时间默认晚上0点开始，每隔24小时执行一次
}

//记录已操作的单词
model WordBookRecord {
  id        String   @id @default(cuid()) // 记录ID
  wordId    String // 单词ID
  isMaster  Boolean  @default(false) // 是否已学完（不是 SRS 的“掌握”）
  createdAt DateTime @default(now()) // 创建时间
  updatedAt DateTime @updatedAt // 更新时间
  userId    String // 用户ID 
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  word      WordBook @relation(fields: [wordId], references: [id], onDelete: Cascade)

  // SRS（SM-2 简化）字段
  mastery        Int       @default(0) // 0-5
  correctCount   Int       @default(0)
  wrongCount     Int       @default(0)
  ease           Float     @default(2.5) // 1.3 - 3.0
  intervalDays   Int       @default(0)
  repetitions    Int       @default(0)
  lastReviewedAt DateTime?
  nextReviewAt   DateTime?

  @@unique([userId, wordId])
  @@index([userId, nextReviewAt])
}

//每一次答题日志，用于统计/错词本/复习
model PracticeLog {
  id           String   @id @default(cuid())
  userId       String
  wordId       String
  courseId     String?
  mode         String // spelling | dictation | recall | review
  isCorrect    Boolean
  revealed     Boolean  @default(false)
  answer       String?
  expected     String?
  durationMs   Int      @default(0)
  inputCount   Int      @default(0)
  correctInput Int      @default(0)
  wrongInput   Int      @default(0)
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, wordId])
  @@index([userId, courseId])
}

//单词表
model WordBook {
  id                String             @id @default(cuid()) // 单词ID
  word              String // 单词
  phonetic          String? // 音标
  definition        String? // 定义
  translation       String? // 翻译
  example           String? // 例句
  pos               String? // 词性
  collins           String? // 柯林斯
  oxford            String? // 牛津
  tag               String? // 标签
  bnc               String? // BNC 英国国家语料库
  frq               String? // FRQ 频率
  exchange          String? // 同义词
  ownerId           String? // null 为公共词典
  owner             User?              @relation("UserWords", fields: [ownerId], references: [id], onDelete: Cascade)
  source            String             @default("system") // system | custom
  gk                Boolean? // 高考
  zk                Boolean? // 中考
  gre               Boolean? // GRE
  toefl             Boolean? // TOEFL 
  ielts             Boolean? // IELTS 
  cet6              Boolean? // 大学英语六级
  cet4              Boolean? // 大学英语四级
  ky                Boolean? // 考研
  createdAt         DateTime           @default(now()) // 创建时间
  updatedAt         DateTime           @updatedAt // 更新时间
  wordBookRecords   WordBookRecord[]
  userWordBookItems UserWordBookItem[]
  courseWords       CourseWord[]

  @@unique([ownerId, word])
  @@index([word])
  @@index([ownerId])
  @@index([tag])
  @@index([word, tag])
}

//支付记录
model PaymentRecord {
  id            String         @id @default(cuid()) // 支付ID
  userId        String // 用户ID
  tradeNo       String? // 支付宝交易号
  outTradeNo    String         @unique // 订单编号
  amount        Decimal // 支付金额
  subject       String // 支付主题
  body          String // 支付内容
  tradeStatus   TradeStatus    @default(NOT_PAY) // 支付状态 默认未支付 NOT_PAY, SUCCESS, FAILED
  sendPayTime   DateTime? // 支付时间
  createdAt     DateTime       @default(now()) // 创建时间
  updatedAt     DateTime       @updatedAt // 更新时间
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseRecords CourseRecord[]

  @@index([tradeNo])
}

model CourseRecord {
  id              String         @id @default(cuid()) // 课程记录ID
  userId          String // 用户ID
  courseId        String // 课程ID
  isPurchased     Boolean        @default(false) // 是否购买
  createdAt       DateTime       @default(now()) // 创建时间
  updatedAt       DateTime       @updatedAt // 更新时间
  paymentRecordId String? // 支付记录ID
  paymentRecord   PaymentRecord? @relation(fields: [paymentRecordId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // 断点续学
  lastWordIndex Int       @default(0)
  lastStudiedAt DateTime?

  @@unique([userId, courseId])
}

model Course {
  id            String         @id @default(cuid()) // 课程ID
  name          String // 课程名
  value         String // 课程value；自定义课程为 custom
  description   String? // 课程描述
  teacher       String // 教师
  url           String // 课程url
  price         Decimal // 课程价格
  ownerId       String? // 自定义课程所属用户；null 为平台课程
  owner         User?          @relation("UserCourses", fields: [ownerId], references: [id], onDelete: Cascade)
  isCustom      Boolean        @default(false)
  wordCount     Int            @default(0)
  createdAt     DateTime       @default(now()) // 创建时间
  updatedAt     DateTime       @updatedAt // 更新时间
  courseRecords CourseRecord[]
  courseWords   CourseWord[]

  @@index([ownerId, isCustom])
}

// 每日学习目标
model StudyGoal {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyNew     Int      @default(10) // 每日新词
  dailyReview  Int      @default(20) // 每日复习
  dailyMinutes Int      @default(15) // 每日学习分钟
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 每日打卡（上海时区的 YYYY-MM-DD）
model CheckIn {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  words     Int      @default(0)
  minutes   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

// AI 对话会话（历史消息仍由 LangGraph checkpointer 保存，thread_id = userId:sessionId）
model ChatSession {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assistantId   String // kaoyan | cet4 | cet6 | grammar | general
  title         String
  lastMessage   String?  @db.Text
  lastMessageAt DateTime @default(now())
  messageCount  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, lastMessageAt])
}

// AI 教练知识库（第一版使用关键词检索；后续可平滑替换为 pgvector）
model KnowledgeChunk {
  id         String   @id @default(cuid())
  key        String   @unique
  examType   String // kaoyan | cet4 | cet6 | grammar | general
  sourceType String // grammar | reading | writing | translation | vocabulary
  title      String
  content    String   @db.Text
  keywords   String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([examType])
  @@index([examType, sourceType])
}

// 用户自定义词库（一组私有词条，不等于可学习课程）
model UserWordBook {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  wordCount   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  items       UserWordBookItem[]

  @@index([userId, updatedAt])
}

model UserWordBookItem {
  id        String       @id @default(cuid())
  bookId    String
  book      UserWordBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  wordId    String
  word      WordBook     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  sortOrder Int          @default(0)

  @@unique([bookId, wordId])
  @@index([wordId])
}

// 自定义课程的单词关联，保留导入顺序
model CourseWord {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  wordId    String
  word      WordBook @relation(fields: [wordId], references: [id], onDelete: Cascade)
  sortOrder Int      @default(0)
  unit      String?

  @@unique([courseId, wordId])
  @@index([wordId])
}

// 导入任务（模板解析、预览、异步入库、错误报告）
model ImportJob {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // wordbook | course
  status    String   @default("pending") // pending | importing | done | failed
  fileName  String
  targetId  String?
  total     Int      @default(0)
  success   Int      @default(0)
  failed    Int      @default(0)
  message   String?
  errors    Json?
  payload   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}
