# ============================================================
# 环境变量示例文件
# 复制为 server/.env 后再填写真实值，不要把 server/.env 提交到 Git
# 所有值均为占位符，请替换为你自己的配置
# ============================================================

# ===== 数据库 =====
# PostgreSQL 连接地址
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/english"

# JWT / Token 签名密钥，请使用足够长的随机字符串
SECRET_KEY="replace-with-a-long-random-secret"

# ===== Redis =====
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
# 本地 Redis 没有密码时留空
REDIS_PASSWORD=""

# ===== MinIO 对象存储 =====
MINIO_ACCESS_KEY="replace-with-minio-access-key"
MINIO_SECRET_KEY="replace-with-minio-secret-key"
MINIO_ENDPOINT="127.0.0.1"
MINIO_PORT=9000
# 1 使用 HTTPS，0 使用 HTTP
MINIO_USE_SSL=0
MINIO_BUCKET="english-app-avatar"

# ===== DeepSeek / LangChain =====
DEEPSEEK_API_KEY="sk-replace-with-deepseek-api-key"
# 普通对话模型；深度思考目前也读取该变量
DEEPSEEK_API_MODEL="deepseek-chat"
# LangGraph checkpointer 使用的 PostgreSQL 地址
AI_DATABASE_URL="postgresql://postgres:your_password@localhost:5432/english"

# ===== 博查搜索 =====
BOCHA_SEARCH_URL="https://api.bochaai.com/v1/web-search"
BOCHA_API_KEY="sk-replace-with-bocha-api-key"

# ===== 支付宝（沙箱示例）=====
# 正式环境请替换为正式 APPID、密钥和网关
ALIPAY_APP_ID="replace-with-alipay-app-id"
ALIPAY_PRIVATE_KEY="replace-with-alipay-app-private-key"
ALIPAY_PUBLIC_KEY="replace-with-alipay-public-key"
ALIPAY_GATEWAY="https://openapi-sandbox.dl.alipaydev.com/gateway.do"
# 异步通知完整地址（必须公网可访问，路径为 /api/v1/pay/notify）
ALIPAY_NOTIFY_URL="https://your-domain.com/api/v1/pay/notify"

# ===== 邮件（以 QQ SMTP 为例）=====
EMAIL_HOST="smtp.qq.com"
EMAIL_PORT=465
EMAIL_USER="your@qq.com"
# QQ 邮箱这里填 SMTP 授权码，不是登录密码
EMAIL_PASSWORD="replace-with-smtp-authorization-code"
EMAIL_FROM="English App <your@qq.com>"
# 1 使用 SSL，0 不使用
EMAIL_USE_SSL=1
